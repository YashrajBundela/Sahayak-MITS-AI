# Copy this file to .env and fill in your Google OAuth credentials.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
SAHAYAK_SESSION_SECRET=replace-with-a-long-random-secret
# Comma-separated exact Google email addresses allowed into Admin Dashboard
SAHAYAK_ADMIN_EMAILS=your-college-email@mitsgwl.ac.in
